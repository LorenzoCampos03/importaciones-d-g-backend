	<parameter name="purchase_id" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT 
    p.purchase_id,
    p.purchase_date,
    p.total_cost,
    p.status,
    s.supplier_name,
    u.name || ' ' || u.last_name as employee_name,
    pd.quantity,
    pd.unit_cost,
    pd.total_cost as detail_total,
    pr.name as product_name,
    pr.description as product_description,
    pr.product_id
FROM lorenzo_campos.purchase p
INNER JOIN lorenzo_campos.supplier s ON p.supplier_id = s.supplier_id
INNER JOIN maria_sulca.users u ON p.employee_id = u.user_id
INNER JOIN lorenzo_campos.purchase_detail pd ON p.purchase_id = pd.purchase_id
INNER JOIN lorenzo_campos.product pr ON pd.product_id = pr.product_id
WHERE p.purchase_id = $P{purchase_id}
ORDER BY pd.purchase_detail_id]]></query>
