	<parameter name="SALE_ID" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT
    s.sale_id,
    TO_CHAR(s.sale_date, 'DD - MON - YYYY HH24:MI:SS') AS sale_date,
    s.total AS Total,
    s.payment_method AS Pago,
    s.delivery_method AS Método,
    s.delivery_address AS Delivery,
    c.name || ' ' || c.last_name AS Cliente,
    e.name || ' ' || e.last_name AS Vendedor,
    s.office_id AS Oficina,
    sd.sale_detail_id,
    sd.product_id AS Producto_ID,
    p.name AS Producto,
    p.description AS Descripción,
    sd.quantity AS Cantidad,
    sd.unit_price AS Precio_Unitario,
    sd.subtotal AS Subtotal
FROM
    maria_sulca.sale s
JOIN
    maria_sulca.sale_detail sd ON s.sale_id = sd.sale_id
JOIN
    maria_sulca.users c ON s.client_id = c.user_id
JOIN
    maria_sulca.users e ON s.employee_id = e.user_id
JOIN
    lorenzo_campos.product p ON sd.product_id = p.product_id
WHERE
    s.sale_id = $P{SALE_ID}
    AND c.role = 'Cliente'
    AND e.role IN ('Vendedor', 'Administrador')
ORDER BY
    s.sale_id ASC, sd.sale_detail_id ASC]]></query>
