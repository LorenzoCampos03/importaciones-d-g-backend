<jasperReport name="ProductListReport" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="84fc740c-845b-4400-b620-074337044a08">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="BaseDeDatos"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<query language="sql"><![CDATA[SELECT 
    p.name,
    p.description,
    p.unit_price,
    p.stock,
    CASE 
        WHEN p.status = 'A' THEN 'Activo'
        WHEN p.status = 'I' THEN 'Inactivo'
        ELSE 'Desconocido'
    END as status_desc,
    c.category_name,
    s.supplier_name,
    b.brand_name,
    p.registration_date
FROM lorenzo_campos.product p
LEFT JOIN lorenzo_campos.category c ON p.category_id = c.category_id
LEFT JOIN lorenzo_campos.supplier s ON p.supplier_id = s.supplier_id  
LEFT JOIN lorenzo_campos.brand b ON p.brand_id = b.brand_id
ORDER BY p.name]]></query>
